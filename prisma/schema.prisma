generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma-client"
  engineType = "client"
  runtime    = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String               @id @default(cuid())
  email        String               @unique
  name         String
  passwordHash String
  birthDate    String
  isAdmin      Boolean              @default(false)
  isBlocked    Boolean              @default(false)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  sessions     Session[]
  resetTokens  PasswordResetToken[]
  state        UserState?
}

model UserState {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  state     Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model HumanDesignTransitRecord {
  id              String   @id @default(cuid())
  title           String
  periodStart     String
  periodEnd       String
  listingUrl      String
  descriptionUrl  String   @unique
  pageNumber      Int
  gateSunNumber   String
  gateSunName     String
  gateSunUrl      String
  gateEarthNumber String
  gateEarthName   String
  gateEarthUrl    String
  gates           Json
  paragraphs      Json
  publishedAt     DateTime?
  fetchedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([periodStart, periodEnd])
  @@index([pageNumber])
}

model AppConfig {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id             String   @id @default(cuid())
  name           String
  email          String
  topic          String
  message        String
  recipientEmail String
  replyTo        String?
  status         String   @default("queued")
  provider       String?
  providerId     String?
  errorMessage   String?
  ipAddress      String?
  userAgent      String?
  sentAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}
